# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Capacitor - Android (build artifacts and local config only)
android/local.properties
android/.gradle/
android/.idea/
android/build/
android/.transforms/
android/app/build/
android/*.iml
android/app/*.iml
android/app/src/main/assets/capacitor.config.json
android/capacitor-cordova-android-plugins/build/

# Capacitor - iOS (build artifacts and local config only)
ios/App/build/
ios/App/Pods/
ios/App/Podfile.lock
ios/App/public/
ios/App/App/public/
ios/**/*.xcworkspace/xcuserdata/
ios/**/*.xcodeproj/xcuserdata/
ios/.DS_Store
*.xcuserstate